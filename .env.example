# Copia este archivo a ".env" y ajusta los valores.
# NUNCA subas el archivo .env real al repositorio.

# Clave secreta de Django. Genera una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria

# Modo depuración: False en producción, True solo en desarrollo local.
DEBUG=True

# Hosts permitidos, separados por comas. Ej: localhost,127.0.0.1
# En producción pon aquí el dominio real.
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes de confianza para CSRF (esquema + dominio), separados por comas.
# Ej: http://localhost:8000,https://estudios.geype.es
CSRF_TRUSTED_ORIGINS=http://localhost:8000
